# Normalise line endings in the repo; check out native line endings per-OS.
* text=auto eol=lf

# Explicit text files
*.rs    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Binary
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.db    binary

# Keep generated lockfiles diff-friendly
Cargo.lock          -diff
package-lock.json   -diff
